    <color name="herdr_blocked">#FFFF6B6B</color>
    <color name="herdr_working">#FF4C8DFF</color>
    <color name="herdr_done">#FF3FB950</color>
    <color name="herdr_idle">#FF6E7681</color>
    <color name="herdr_unknown">#FF8B949E</color>
</resources>
